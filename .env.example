# Warrant Environment Configuration Example
# All values here are placeholders. Copy to .env for local development.
# NEVER commit real credentials or secrets to source control.

# Application Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001

# PostgreSQL Database (Local development default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warrant_dev

# PayPal Configuration (SANDBOX ONLY - Live payments are strictly prohibited in MVP)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=placeholder_sandbox_client_id
PAYPAL_CLIENT_SECRET=placeholder_sandbox_client_secret
PAYPAL_WEBHOOK_ID=placeholder_sandbox_webhook_id

# Checkout Invariant Defaults (Seconds)
CHECKOUT_NONCE_TTL_SECONDS=300
BUYER_APPROVAL_RESERVATION_TTL_SECONDS=900
RECONCILIATION_ALERT_AFTER_SECONDS=900

# Optional AI / LLM Assistant (Falls back automatically to deterministic compiler if omitted)
GEMINI_API_KEY=placeholder_gemini_api_key

# Bounded Search Configuration
SEARCH_MAX_CANDIDATES=100
SEARCH_TIMEOUT_MS=10000

# Logging & CORS
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
