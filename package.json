{
  "name": "warrant-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@warrant/api",
    "dev:web": "npm run dev --workspace=@warrant/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@warrant/api",
    "start:api": "npm run start --workspace=@warrant/api",
    "preview:web": "npm run preview --workspace=@warrant/web",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx apps/api/src/scripts/seedDemoData.ts",
    "demo:reset": "tsx apps/api/src/scripts/seedDemoData.ts --force-reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
